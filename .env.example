# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/period_tracker?schema=public

# JWT / Auth
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS / Frontend
FRONTEND_URL=http://localhost:3000

# Cookies
COOKIE_SECURE=false

# Password reset
RESET_TOKEN_EXPIRES_IN_MINUTES=30
